<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="return">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="result">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element type="xs:byte" name="status"/>
                            <xs:element type="xs:string" name="message"/>
                            <xs:element type="xs:long" name="serverTime"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="sender">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element type="xs:string" name="cardNumber"/>
                            <xs:element type="xs:string" name="cardHolder"/>
                            <xs:element type="xs:string" name="cardType"/>
                            <xs:element type="xs:byte" name="bankId"/>
                            <xs:element type="xs:string" name="bankName"/>
                            <xs:element name="bankLogoOptions">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element type="xs:string" name="logo"/>
                                        <xs:element type="xs:string" name="light"/>
                                        <xs:element type="xs:string" name="colorStart"/>
                                        <xs:element type="xs:string" name="colorEnd"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element type="xs:int" name="accountId"/>
                            <xs:element type="xs:string" name="accountType"/>
                            <xs:element name="currency">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element type="xs:byte" name="code"/>
                                        <xs:element type="xs:string" name="symbol"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="receiver">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element type="xs:string" name="cardNumber"/>
                            <xs:element type="xs:string" name="cardHolder"/>
                            <xs:element type="xs:string" name="cardType"/>
                            <xs:element type="xs:byte" name="bankId"/>
                            <xs:element type="xs:string" name="bankName"/>
                            <xs:element name="bankLogoOptions">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element type="xs:string" name="logo"/>
                                        <xs:element type="xs:string" name="light"/>
                                        <xs:element type="xs:string" name="colorStart"/>
                                        <xs:element type="xs:string" name="colorEnd"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element type="xs:int" name="accountId"/>
                            <xs:element type="xs:string" name="accountType"/>
                            <xs:element name="currency">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element type="xs:byte" name="code"/>
                                        <xs:element type="xs:string" name="symbol"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="amount">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element type="xs:byte" name="defaultValue"/>
                            <xs:element type="xs:string" name="editable"/>
                            <xs:element type="xs:int" name="limitMin"/>
                            <xs:element type="xs:long" name="limitMax"/>
                            <xs:element type="xs:long" name="onceMaxAmount"/>
                            <xs:element type="xs:string" name="availableDecimal"/>
                            <xs:element name="currency">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element type="xs:byte" name="code"/>
                                        <xs:element type="xs:string" name="symbol"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="uzsAmount">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element type="xs:byte" name="defaultValue"/>
                            <xs:element type="xs:string" name="editable"/>
                            <xs:element type="xs:int" name="limitMin"/>
                            <xs:element type="xs:long" name="limitMax"/>
                            <xs:element type="xs:long" name="onceMaxAmount"/>
                            <xs:element type="xs:string" name="availableDecimal"/>
                            <xs:element name="currency">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element type="xs:byte" name="code"/>
                                        <xs:element type="xs:string" name="symbol"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="serviceCharge">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element type="xs:float" name="value"/>
                            <xs:element type="xs:string" name="type"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="serviceChargeDiscount">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element type="xs:string" name="isDiscountAvailable"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>